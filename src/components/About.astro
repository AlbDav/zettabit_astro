---
import { Picture } from 'astro:assets';
import { site, skills, certifications } from '../data/site';
import { defaultLang, getContent, useTranslations } from '../i18n/utils';
import profilePhoto from '../assets/images/profile.jpg';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
const content = getContent(lang);

const bioDetail = t('about.bioDetail');
const hasCerts = certifications.length > 0;
---

<section id="about" class="min-h-screen flex flex-col justify-center py-20 px-4 md:px-8 max-w-6xl mx-auto">
	<div class="grid md:grid-cols-3 gap-10 items-start">
		<div class="flex flex-col items-center md:items-start gap-4" data-animate style="--d: 0">
			<div class="avatar">
				<div class="w-28 rounded-full ring ring-primary/30 ring-offset-base-100 ring-offset-2">
					<Picture src={profilePhoto} formats={['avif', 'webp']} alt={site.name} width={224} height={224} class="object-cover" />
				</div>
			</div>
			<div class="text-center md:text-left">
				<p class="font-semibold">{site.name}</p>
				<p class="text-sm text-base-content/70">{content.role}</p>
				<p class="text-sm text-base-content/70 mt-2 max-w-xs">{t('about.location')}</p>
			</div>
		</div>
		<div class="md:col-span-2 flex flex-col gap-6" data-animate style="--d: 1">
			<h2 class="text-3xl md:text-4xl font-bold">{t('about.title')}</h2>
			<p class="text-base-content/70 leading-relaxed">{t('about.bio')}</p>
			<p class="text-base-content/70 leading-relaxed">{bioDetail}</p>

			{hasCerts && (
				<div class="flex flex-col gap-3">
					<h3 class="text-sm font-semibold uppercase tracking-wide text-base-content/70">{t('about.certTitle')}</h3>
					<ul class="flex flex-wrap gap-2">
						{certifications.map((cert) => (
							<li class="badge badge-primary badge-outline gap-1 py-3">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
									<path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-3-3a1 1 0 111.4-1.4L9 11.6l6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd" />
								</svg>
								{cert}
							</li>
						))}
					</ul>
				</div>
			)}

			<details class="text-sm text-base-content/70">
				<summary class="cursor-pointer font-medium text-base-content/70 hover:text-base-content">
					{t('about.techToggle')}
				</summary>
				<ul class="mt-3 flex flex-wrap gap-2">
					{skills.map((skill) => <li class="badge badge-ghost badge-sm">{skill}</li>)}
				</ul>
			</details>
		</div>
	</div>
</section>
