---
import { Picture } from 'astro:assets';
import { site, skills, certifications } from '../data/site';
import { defaultLang, getContent, useTranslations } from '../i18n/utils';
import profilePhoto from '../assets/images/profile.jpg';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
const content = getContent(lang);

const hasCerts = certifications.length > 0;
---

<section id="about" class="min-h-screen flex flex-col justify-center bg-base-200 py-16 px-4 md:px-8 md:py-24">
	<div class="mx-auto w-full max-w-6xl grid gap-10 md:grid-cols-2 md:gap-14 items-start">
		<div data-animate style="--d: 0">
			<p class="font-mono text-xs uppercase tracking-[0.14em] text-primary">05 — {t('about.title')}</p>
			<h2 class="mt-4 max-w-[22ch] font-display text-3xl font-semibold leading-[1.12] tracking-tight md:text-4xl">
				{content.aboutHeadline}
			</h2>
			<p class="mt-4 max-w-[50ch] text-base-content/60 leading-relaxed text-pretty">{content.role}</p>
			<p class="mt-3 max-w-[50ch] text-base-content/70 leading-relaxed text-pretty">{t('about.bio')}</p>
			<p class="mt-3 text-sm text-base-content/50">{t('about.location')}</p>

			{hasCerts && (
				<div class="mt-6 flex flex-col gap-3">
					<h3 class="text-sm font-semibold uppercase tracking-wide text-base-content/70">{t('about.certTitle')}</h3>
					<ul class="flex flex-wrap gap-2">
						{certifications.map((cert) => (
							<li class="badge badge-primary badge-outline gap-1 py-3">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
									<path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-3-3a1 1 0 111.4-1.4L9 11.6l6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd" />
								</svg>
								{cert}
							</li>
						))}
					</ul>
				</div>
			)}
		</div>

		<div class="rounded-2xl border border-base-content/10 bg-[#2a323c] p-6 md:p-8" data-animate style="--d: 1">
			<div class="flex items-center gap-4">
				<div class="avatar shrink-0">
					<div class="w-16 rounded-full">
						<Picture src={profilePhoto} formats={['avif', 'webp']} alt={site.name} width={128} height={128} class="object-cover" />
					</div>
				</div>
				<div>
					<p class="font-display font-semibold text-[17px]">{site.name}</p>
					<p class="text-sm text-base-content/50 mt-1">{content.role}</p>
				</div>
			</div>
			<p class="font-mono text-[11.5px] uppercase tracking-[0.12em] text-primary mt-6 mb-3">{t('about.techToggle')}</p>
			<ul class="flex flex-wrap gap-2">
				{skills.map((skill) => (
					<li class="text-[13.5px] text-base-content/70 border border-base-content/15 rounded-full px-3 py-1.5">{skill}</li>
				))}
			</ul>
		</div>
	</div>
</section>
