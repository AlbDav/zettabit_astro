---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
import { defaultLang, useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
---

<section id="contact" class="min-h-screen flex flex-col justify-center py-20 px-4 md:px-8 bg-base-200">
	<div class="max-w-3xl mx-auto text-center flex flex-col items-center gap-6">
		<h2 class="text-3xl md:text-4xl font-bold" data-animate style="--d: 0">{t('contact.title')}</h2>
		<p class="text-base-content/70" data-animate style="--d: 1">{t('contact.subtitle')}</p>
		<a href={`mailto:${site.email}`} class="btn btn-primary btn-lg" data-animate style="--d: 2">{site.email}</a>
		<div data-animate style="--d: 3">
			<SocialLinks class="mt-2" />
		</div>
	</div>
</section>
