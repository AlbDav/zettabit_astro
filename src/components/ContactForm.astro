---
import { site } from '../data/site';
import { defaultLang, getContent, getLocalizedPath, useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
const { form } = getContent(lang);
const s = form.steps;

// Email split so it is never present in the HTML as a single scrapable string.
const [emailUser, emailDomain] = site.email.split('@');
const privacyPath = `${getLocalizedPath(lang)}privacy/`;

const progressInitial = form.progressTemplate
	.replace('{current}', '1')
	.replace('{total}', String(form.totalSteps));

// Strings the client script needs, passed as a JSON payload on the form.
const cfg = JSON.stringify({
	progress: form.progressTemplate,
	errChoose: form.errors.choose,
	errName: form.errors.name,
	errEmail: form.errors.email,
	errConsent: form.errors.consent,
	sending: form.sending,
	submit: form.submit,
});
---

<form
	name="contatti"
	method="POST"
	data-netlify="true"
	netlify-honeypot="bot-field"
	action={getLocalizedPath(lang)}
	class="msf w-full max-w-xl mx-auto text-left"
	data-cfg={cfg}
	novalidate
>
	<input type="hidden" name="form-name" value="contatti" />
	<p class="hidden" aria-hidden="true">
		<label>Don’t fill this out if you’re human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
	</p>

	<!-- Progress (JS only): honest "Passo X di Y" -->
	<div class="msf-progress mb-6 flex items-center gap-3" data-progress-wrap>
		<div class="h-1.5 flex-1 rounded-full bg-base-content/10 overflow-hidden">
			<div class="msf-progress-bar h-full bg-primary transition-all duration-300" style="width: 33%" data-progress-bar></div>
		</div>
		<span class="text-sm text-base-content/70 whitespace-nowrap" data-progress-label>{progressInitial}</span>
	</div>

	<!-- Live region: announces step changes to screen readers -->
	<p class="sr-only" role="status" aria-live="polite" data-live></p>

	<!-- STEP 1 — need -->
	<div class="msf-step" data-step="need">
		<fieldset>
			<legend class="text-xl md:text-2xl font-bold mb-4" tabindex="-1" data-step-title>{s.need.title}</legend>
			<div class="grid grid-cols-2 gap-3" role="radiogroup">
				{s.need.options.map((o) => (
					<label class="msf-card">
						<input type="radio" name={s.need.field} value={o.value} class="peer sr-only" />
						<span class="msf-card-face">{o.label}</span>
					</label>
				))}
			</div>
			<p class="msf-error mt-2 text-sm text-error" role="alert" data-error-for={s.need.field} hidden></p>
		</fieldset>
	</div>

	<!-- STEP 2 — qualify (conditional groups + budget) -->
	<div class="msf-step" data-step="qualify">
		<div class="flex flex-col gap-8">
			<fieldset data-when="web">
				<legend class="text-xl md:text-2xl font-bold mb-4" tabindex="-1" data-step-title>{s.projectType.title}</legend>
				<div class="grid gap-3" role="radiogroup">
					{s.projectType.options.map((o) => (
						<label class="msf-card">
							<input type="radio" name={s.projectType.field} value={o.value} class="peer sr-only" />
							<span class="msf-card-face">{o.label}</span>
						</label>
					))}
				</div>
			</fieldset>

			<fieldset data-when="video">
				<legend class="text-xl md:text-2xl font-bold mb-4" tabindex="-1" data-step-title>{s.videoScope.title}</legend>
				<div class="grid gap-3" role="radiogroup">
					{s.videoScope.options.map((o) => (
						<label class="msf-card">
							<input type="radio" name={s.videoScope.field} value={o.value} class="peer sr-only" />
							<span class="msf-card-face">{o.label}</span>
						</label>
					))}
				</div>
			</fieldset>

			<fieldset>
				<legend class="text-lg font-semibold mb-4">{s.budget.title}</legend>
				<div class="grid grid-cols-2 gap-3" role="radiogroup">
					{s.budget.options.map((o) => (
						<label class="msf-card">
							<input type="radio" name={s.budget.field} value={o.value} class="peer sr-only" />
							<span class="msf-card-face">{o.label}</span>
						</label>
					))}
				</div>
			</fieldset>
		</div>
	</div>

	<!-- STEP 3 — details -->
	<div class="msf-step" data-step="details">
		<h3 class="text-xl md:text-2xl font-bold mb-4" tabindex="-1" data-step-title>{s.details.title}</h3>
		<div class="flex flex-col gap-4">
			<div class="flex flex-col gap-1">
				<label for="msf-name" class="text-sm font-medium">{s.details.name}</label>
				<input id="msf-name" name="name" type="text" autocomplete="name" required class="input input-bordered w-full" />
				<p class="msf-error text-sm text-error" role="alert" data-error-for="name" hidden></p>
			</div>
			<div class="flex flex-col gap-1">
				<label for="msf-email" class="text-sm font-medium">{s.details.email}</label>
				<input id="msf-email" name="email" type="email" autocomplete="email" required class="input input-bordered w-full" />
				<p class="msf-error text-sm text-error" role="alert" data-error-for="email" hidden></p>
			</div>
			<div class="flex flex-col gap-1">
				<label for="msf-message" class="text-sm font-medium">{s.details.message}</label>
				<textarea id="msf-message" name="message" rows="4" class="textarea textarea-bordered w-full"></textarea>
			</div>
			<div class="flex flex-col gap-1">
				<label class="flex items-start gap-2 text-sm">
					<input id="msf-consent" name="consent" type="checkbox" required class="checkbox checkbox-sm mt-0.5" />
					<span>
						{s.details.consentBefore}<a href={privacyPath} class="link link-primary">{s.details.consentLink}</a>{s.details.consentAfter}
					</span>
				</label>
				<p class="msf-error text-sm text-error" role="alert" data-error-for="consent" hidden></p>
			</div>
		</div>
	</div>

	<!-- Navigation (JS only) -->
	<div class="msf-nav mt-8 items-center justify-between gap-3">
		<button type="button" class="btn btn-ghost" data-back hidden>{form.back}</button>
		<div class="ml-auto flex gap-3">
			<button type="button" class="btn btn-primary" data-next>{form.next}</button>
			<button type="submit" class="btn btn-primary" data-submit hidden>{form.submit}</button>
		</div>
	</div>

	<!-- Fallback submit (no-JS): all steps visible, single submit -->
	<div class="msf-fallback-submit mt-8">
		<button type="submit" class="btn btn-primary btn-wide">{form.submit}</button>
	</div>

	<!-- Escape hatch — always visible, email assembled client-side -->
	<p class="mt-8 text-center text-sm text-base-content/70">
		{form.escapePrompt}{' '}
		<a
			class="link link-hover text-base-content/80"
			data-email-user={emailUser}
			data-email-domain={emailDomain}
		>
			<noscript>{emailUser} [at] {emailDomain}</noscript>
		</a>
	</p>
</form>

<!-- Success / error states (revealed by JS, replacing the form) -->
<div class="msf-result hidden text-center" data-result hidden>
	<div class="msf-success hidden flex-col items-center gap-3" data-success hidden>
		<div class="flex h-14 w-14 items-center justify-center rounded-full bg-primary/15 text-primary">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-3-3a1 1 0 111.4-1.4L9 11.6l6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd" />
			</svg>
		</div>
		<p class="text-2xl font-bold">{form.successTitle}</p>
		<p class="text-base-content/70">{form.successBody}</p>
	</div>
	<p class="msf-senderror hidden text-error" data-senderror hidden>
		{form.sendErrorBefore}<a class="link" data-email-user={emailUser} data-email-domain={emailDomain}></a>{form.sendErrorAfter}
	</p>
</div>

<script>
	type StepId = 'need' | 'qualify' | 'details';

	const forms = document.querySelectorAll<HTMLFormElement>('form.msf');
	forms.forEach(initForm);

	function initForm(form: HTMLFormElement) {
		const steps = Array.from(form.querySelectorAll<HTMLElement>('.msf-step'));
		const live = form.querySelector<HTMLElement>('[data-live]');
		const progressLabel = form.querySelector<HTMLElement>('[data-progress-label]');
		const progressBar = form.querySelector<HTMLElement>('[data-progress-bar]');
		const backBtn = form.querySelector<HTMLButtonElement>('[data-back]');
		const nextBtn = form.querySelector<HTMLButtonElement>('[data-next]');
		const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]');

		// Read i18n strings that JS needs from the JSON payload on the form.
		const cfg = JSON.parse(form.dataset.cfg || '{}');

		// Assemble obfuscated emails across the form and its sibling result box.
		form.parentElement
			?.querySelectorAll<HTMLAnchorElement>('a[data-email-user]')
			.forEach(setEmail);

		function setEmail(a: HTMLAnchorElement) {
			const addr = `${a.dataset.emailUser}@${a.dataset.emailDomain}`;
			a.href = `mailto:${addr}`;
			if (!a.textContent?.trim() || a.querySelector('noscript')) a.textContent = addr;
		}

		// Enable JS multi-step mode.
		form.dataset.js = 'true';

		let sequence: StepId[] = ['need', 'qualify', 'details'];
		let index = 0;

		function needValue() {
			return (
				form.querySelector<HTMLInputElement>('input[name="need"]:checked')?.value ?? ''
			);
		}

		function computeSequence(): StepId[] {
			const need = needValue();
			const seq: StepId[] = ['need'];
			if (need && need !== 'unsure') seq.push('qualify');
			seq.push('details');
			return seq;
		}

		function updateConditionalGroups() {
			const need = needValue();
			const showWeb = need === 'website' || need === 'both';
			const showVideo = need === 'video' || need === 'both';
			form.querySelectorAll<HTMLElement>('[data-when="web"]').forEach((el) => {
				el.hidden = !showWeb;
			});
			form.querySelectorAll<HTMLElement>('[data-when="video"]').forEach((el) => {
				el.hidden = !showVideo;
			});
		}

		function render(focus: boolean) {
			const current = sequence[index];
			steps.forEach((step) => {
				const active = step.dataset.step === current;
				step.toggleAttribute('data-active', active);
			});
			if (current === 'qualify') updateConditionalGroups();

			if (backBtn) backBtn.hidden = index === 0;
			const last = index === sequence.length - 1;
			if (nextBtn) nextBtn.hidden = last;
			if (submitBtn) submitBtn.hidden = !last;

			const label = cfg.progress
				.replace('{current}', String(index + 1))
				.replace('{total}', String(sequence.length));
			if (progressLabel) progressLabel.textContent = label;
			if (progressBar) progressBar.style.width = `${((index + 1) / sequence.length) * 100}%`;
			if (live) live.textContent = label;

			if (focus) {
				const activeStep = steps.find((st) => st.dataset.step === current);
				const title = activeStep
					? Array.from(activeStep.querySelectorAll<HTMLElement>('[data-step-title]')).find(
							(el) => el.offsetParent !== null
					  )
					: null;
				title?.focus();
			}
		}

		function clearError(field: string) {
			const err = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
			if (err) {
				err.hidden = true;
				err.textContent = '';
			}
			form
				.querySelectorAll<HTMLElement>(`[name="${field}"]`)
				.forEach((el) => el.removeAttribute('aria-invalid'));
		}

		function showError(field: string, message: string) {
			const err = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
			if (err) {
				err.textContent = message;
				err.hidden = false;
				err.id = err.id || `msf-err-${field}`;
			}
			const inputs = form.querySelectorAll<HTMLElement>(`[name="${field}"]`);
			inputs.forEach((el) => {
				el.setAttribute('aria-invalid', 'true');
				if (err) el.setAttribute('aria-describedby', err.id);
			});
			(inputs[0] as HTMLElement | undefined)?.focus();
		}

		function validateStep(): boolean {
			const current = sequence[index];
			if (current === 'need') {
				if (!needValue()) {
					showError('need', cfg.errChoose);
					return false;
				}
				clearError('need');
			}
			if (current === 'details') {
				let ok = true;
				const name = form.querySelector<HTMLInputElement>('[name="name"]');
				const email = form.querySelector<HTMLInputElement>('[name="email"]');
				const consent = form.querySelector<HTMLInputElement>('[name="consent"]');
				if (consent && !consent.checked) {
					showError('consent', cfg.errConsent);
					ok = false;
				} else clearError('consent');
				if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
					showError('email', cfg.errEmail);
					ok = false;
				} else clearError('email');
				if (name && !name.value.trim()) {
					showError('name', cfg.errName);
					ok = false;
				} else clearError('name');
				return ok;
			}
			return true;
		}

		nextBtn?.addEventListener('click', () => {
			if (!validateStep()) return;
			if (index === 0) sequence = computeSequence();
			index = Math.min(index + 1, sequence.length - 1);
			render(true);
		});

		backBtn?.addEventListener('click', () => {
			index = Math.max(index - 1, 0);
			render(true);
		});

		form
			.querySelectorAll<HTMLInputElement>('input[name="need"]')
			.forEach((r) => r.addEventListener('change', () => clearError('need')));

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!validateStep()) return;
			if (submitBtn) {
				submitBtn.disabled = true;
				submitBtn.textContent = cfg.sending;
			}
			try {
				const data = new FormData(form);
				const res = await fetch(form.getAttribute('action') || '/', {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
					body: new URLSearchParams(data as any).toString(),
				});
				if (!res.ok) throw new Error(String(res.status));
				showResult(true);
			} catch {
				showResult(false);
				if (submitBtn) {
					submitBtn.disabled = false;
					submitBtn.textContent = cfg.submit;
				}
			}
		});

		function showResult(success: boolean) {
			const result = form.parentElement?.querySelector<HTMLElement>('[data-result]');
			const successBox = result?.querySelector<HTMLElement>('[data-success]');
			const errorBox = result?.querySelector<HTMLElement>('[data-senderror]');
			if (success) {
				form.hidden = true;
				form.style.display = 'none';
			}
			if (result) {
				result.hidden = false;
				result.classList.remove('hidden');
			}
			if (successBox) {
				successBox.hidden = !success;
				successBox.classList.toggle('hidden', !success);
				successBox.classList.toggle('flex', success);
			}
			if (errorBox) {
				errorBox.hidden = success;
				errorBox.classList.toggle('hidden', success);
			}
			if (success) result?.setAttribute('tabindex', '-1');
			if (success) (result as HTMLElement | null)?.focus();
		}

		render(false);
	}
</script>
