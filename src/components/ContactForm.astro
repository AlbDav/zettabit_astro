---
import { site } from '../data/site';
import { defaultLang, getContent, getLocalizedPath, useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
const { form } = getContent(lang);

// Email split so it is never present in the HTML as a single scrapable string.
const [emailUser, emailDomain] = site.email.split('@');
const privacyPath = `${getLocalizedPath(lang)}privacy/`;

// Strings the client script needs, passed as a JSON payload on the form.
const cfg = JSON.stringify({
	errChoose: form.errors.choose,
	errName: form.errors.name,
	errEmail: form.errors.email,
	errConsent: form.errors.consent,
	sending: form.sending,
	submit: form.submit,
});
---

<form
	name="contatti"
	method="POST"
	data-netlify="true"
	netlify-honeypot="bot-field"
	action={getLocalizedPath(lang)}
	class="cf w-full text-left rounded-2xl border border-base-content/10 bg-[#2a323c] p-6 md:p-8 flex flex-col gap-5"
	data-cfg={cfg}
	novalidate
>
	<input type="hidden" name="form-name" value="contatti" />
	<p class="hidden" aria-hidden="true">
		<label>Don’t fill this out if you’re human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
	</p>

	<fieldset>
		<legend class="text-[14.5px] font-semibold text-base-content mb-3">{form.needTitle}</legend>
		<div class="flex flex-wrap gap-2.5" role="radiogroup">
			{form.needOptions.map((o) => (
				<label class="cf-chip">
					<input type="radio" name={form.needField} value={o.value} class="peer sr-only" />
					<span class="cf-chip-face">{o.label}</span>
				</label>
			))}
		</div>
		<p class="cf-error mt-2 text-sm text-error" role="alert" data-error-for={form.needField} hidden></p>
	</fieldset>

	<div class="flex flex-col gap-4">
		<div class="flex flex-col gap-1.5">
			<label for="cf-name" class="text-[13.5px] text-base-content/60">{form.name}</label>
			<input
				id="cf-name"
				name="name"
				type="text"
				autocomplete="name"
				required
				class="input input-bordered w-full bg-base-200 border-base-content/15 rounded-[9px] text-[15.5px] focus:border-primary"
			/>
			<p class="cf-error text-sm text-error" role="alert" data-error-for="name" hidden></p>
		</div>
		<div class="flex flex-col gap-1.5">
			<label for="cf-email" class="text-[13.5px] text-base-content/60">{form.email}</label>
			<input
				id="cf-email"
				name="email"
				type="email"
				autocomplete="email"
				required
				class="input input-bordered w-full bg-base-200 border-base-content/15 rounded-[9px] text-[15.5px] focus:border-primary"
			/>
			<p class="cf-error text-sm text-error" role="alert" data-error-for="email" hidden></p>
		</div>
	</div>

	<div class="flex flex-col gap-1.5">
		<label for="cf-message" class="text-[13.5px] text-base-content/60">{form.message}</label>
		<textarea
			id="cf-message"
			name="message"
			rows="4"
			placeholder={form.messagePlaceholder}
			class="textarea textarea-bordered w-full bg-base-200 border-base-content/15 rounded-[9px] text-[15.5px] focus:border-primary"
		></textarea>
	</div>

	<div class="flex flex-col gap-1.5">
		<label class="flex items-start gap-2.5 text-[13.5px] leading-relaxed text-base-content/60 cursor-pointer">
			<input id="cf-consent" name="consent" type="checkbox" required class="checkbox checkbox-sm mt-0.5 shrink-0" />
			<span>
				{form.consentBefore}<a href={privacyPath} class="link link-primary">{form.consentLink}</a>{form.consentAfter}
			</span>
		</label>
		<p class="cf-error text-sm text-error" role="alert" data-error-for="consent" hidden></p>
	</div>

	<button type="submit" class="btn btn-primary rounded-lg w-full" data-submit>{form.submit}</button>
</form>

<!-- Success / error states (revealed by JS, replacing the form) -->
<div class="cf-result hidden w-full text-center" data-result hidden>
	<div class="hidden flex-col items-center gap-3 rounded-2xl border border-primary/40 bg-[#2a323c] p-8" data-success hidden>
		<p class="font-display text-2xl font-semibold">{form.successTitle}</p>
		<p class="text-[15.5px] leading-relaxed text-base-content/60">{form.successBody}</p>
		<button
			type="button"
			class="btn btn-ghost rounded-lg border border-base-content/[0.18] mt-2 hover:border-primary"
			data-reset
		>
			{form.resetLabel}
		</button>
	</div>
	<p class="hidden text-error" data-senderror hidden>
		{form.sendErrorBefore}<a class="link" data-email-user={emailUser} data-email-domain={emailDomain}></a>{form.sendErrorAfter}
	</p>
</div>

<script>
	document.querySelectorAll<HTMLFormElement>('form.cf').forEach(initForm);

	function initForm(form: HTMLFormElement) {
		const cfg = JSON.parse(form.dataset.cfg || '{}');

		// Assemble obfuscated emails across the form and its sibling result box.
		form.parentElement
			?.querySelectorAll<HTMLAnchorElement>('a[data-email-user]')
			.forEach(setEmail);

		function setEmail(a: HTMLAnchorElement) {
			const addr = `${a.dataset.emailUser}@${a.dataset.emailDomain}`;
			a.href = `mailto:${addr}`;
			if (!a.textContent?.trim() || a.querySelector('noscript')) a.textContent = addr;
		}

		function clearError(field: string) {
			const err = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
			if (err) {
				err.hidden = true;
				err.textContent = '';
			}
			form.querySelectorAll<HTMLElement>(`[name="${field}"]`).forEach((el) => el.removeAttribute('aria-invalid'));
		}

		function showError(field: string, message: string) {
			const err = form.querySelector<HTMLElement>(`[data-error-for="${field}"]`);
			if (err) {
				err.textContent = message;
				err.hidden = false;
				err.id = err.id || `cf-err-${field}`;
			}
			const inputs = form.querySelectorAll<HTMLElement>(`[name="${field}"]`);
			inputs.forEach((el) => {
				el.setAttribute('aria-invalid', 'true');
				if (err) el.setAttribute('aria-describedby', err.id);
			});
			(inputs[0] as HTMLElement | undefined)?.focus();
		}

		function validate(): boolean {
			let ok = true;
			const need = form.querySelector<HTMLInputElement>('input[name="need"]:checked');
			if (!need) {
				showError('need', cfg.errChoose);
				ok = false;
			} else clearError('need');

			const name = form.querySelector<HTMLInputElement>('[name="name"]');
			const email = form.querySelector<HTMLInputElement>('[name="email"]');
			const consent = form.querySelector<HTMLInputElement>('[name="consent"]');

			if (name && !name.value.trim()) {
				showError('name', cfg.errName);
				ok = false;
			} else clearError('name');

			if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
				showError('email', cfg.errEmail);
				ok = false;
			} else clearError('email');

			if (consent && !consent.checked) {
				showError('consent', cfg.errConsent);
				ok = false;
			} else clearError('consent');

			return ok;
		}

		form
			.querySelectorAll<HTMLInputElement>('input[name="need"]')
			.forEach((r) => r.addEventListener('change', () => clearError('need')));

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!validate()) return;
			const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]');
			if (submitBtn) {
				submitBtn.disabled = true;
				submitBtn.textContent = cfg.sending;
			}
			try {
				const data = new FormData(form);
				const res = await fetch(form.getAttribute('action') || '/', {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
					body: new URLSearchParams(data as any).toString(),
				});
				if (!res.ok) throw new Error(String(res.status));
				showResult(true);
			} catch {
				showResult(false);
				if (submitBtn) {
					submitBtn.disabled = false;
					submitBtn.textContent = cfg.submit;
				}
			}
		});

		form.parentElement?.querySelector<HTMLButtonElement>('[data-reset]')?.addEventListener('click', () => {
			form.reset();
			form.hidden = false;
			form.style.display = '';
			const result = form.parentElement?.querySelector<HTMLElement>('[data-result]');
			if (result) {
				result.hidden = true;
				result.classList.add('hidden');
			}
		});

		function showResult(success: boolean) {
			const result = form.parentElement?.querySelector<HTMLElement>('[data-result]');
			const successBox = result?.querySelector<HTMLElement>('[data-success]');
			const errorBox = result?.querySelector<HTMLElement>('[data-senderror]');
			if (success) {
				form.hidden = true;
				form.style.display = 'none';
			}
			if (result) {
				result.hidden = false;
				result.classList.remove('hidden');
			}
			if (successBox) {
				successBox.hidden = !success;
				successBox.classList.toggle('hidden', !success);
				successBox.classList.toggle('flex', success);
			}
			if (errorBox) {
				errorBox.hidden = success;
				errorBox.classList.toggle('hidden', success);
			}
			if (success) result?.setAttribute('tabindex', '-1');
			if (success) (result as HTMLElement | null)?.focus();
		}
	}
</script>
