---
import { pricing } from '../data/site';
import { defaultLang, formatPrice, getContent, getPricingPath, useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
const { faq } = getContent(lang);

const pricesHref = getPricingPath(lang);
const pricesLabel = t('nav.prices');

// `{prezzi}` diventa un link a vista e testo normale nel JSON-LD: schema.org
// vuole la risposta in chiaro, non il markup.
const items = faq.map((item) => {
	const a = item.a.replace('{price}', formatPrice(lang, pricing.web));
	const [before, after] = a.split('{prezzi}');
	return { ...item, text: a.replace('{prezzi}', pricesLabel), before, after };
});

// FAQPage structured data — only emitted once every answer is real (not a
// placeholder). This is data correctness, not a display flag: emitting
// "[DA COMPILARE]" into schema.org would poison search results.
const answersReady = items.every((item) => !item.text.startsWith('['));
const jsonLd = answersReady
	? {
			'@context': 'https://schema.org',
			'@type': 'FAQPage',
			mainEntity: items.map((item) => ({
				'@type': 'Question',
				name: item.q,
				acceptedAnswer: { '@type': 'Answer', text: item.text },
			})),
		}
	: null;
---

{
	(
		<section id="faq" class="min-h-screen flex flex-col justify-start pt-24 pb-16 px-4 md:px-8 md:pt-32 md:pb-24">
			<div class="mx-auto w-full max-w-6xl" data-animate>
				<p class="font-mono text-xs uppercase tracking-[0.14em] text-primary">04 — {t('nav.faq')}</p>
				<h2 class="mt-4 mb-8 max-w-[26ch] font-display text-3xl font-semibold leading-[1.12] tracking-tight md:mb-10 md:text-4xl">
					{t('faq.title')}
				</h2>
				<div class="max-w-3xl divide-y divide-base-content/10 overflow-hidden rounded-2xl border border-base-content/10 bg-[#2a323c]">
					{items.map((item) => (
						<details class="group px-5 md:px-6">
							<summary class="flex cursor-pointer items-start justify-between gap-4 py-5 font-medium text-[16.5px] list-none hover:text-primary">
								{item.q}
								<span class="shrink-0 font-mono text-lg leading-none text-primary transition-transform group-open:rotate-45">+</span>
							</summary>
							<p class="pb-6 pr-11 text-[15.5px] leading-relaxed text-base-content/70 text-pretty">
								{item.before}
								{item.after !== undefined && (
									<Fragment>
										<a href={pricesHref} class="text-primary border-b border-primary/45 pb-0.5 hover:text-primary/80">
											{pricesLabel}
										</a>
										{item.after}
									</Fragment>
								)}
							</p>
						</details>
					))}
				</div>
			</div>
		</section>
	)
}
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
