---
import { pricing } from '../data/site';
import { defaultLang, getContent, useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
const { faq } = getContent(lang);

const items = faq.map((item) => ({ ...item, a: item.a.replace('{price}', String(pricing.web)) }));

// FAQPage structured data — only emitted once every answer is real (not a
// placeholder). This is data correctness, not a display flag: emitting
// "[DA COMPILARE]" into schema.org would poison search results.
const answersReady = items.every((item) => !item.a.startsWith('['));
const jsonLd = answersReady
	? {
			'@context': 'https://schema.org',
			'@type': 'FAQPage',
			mainEntity: items.map((item) => ({
				'@type': 'Question',
				name: item.q,
				acceptedAnswer: { '@type': 'Answer', text: item.a },
			})),
		}
	: null;
---

{
	(
		<section id="faq" class="min-h-screen flex flex-col justify-center py-16 px-4 md:px-8 md:py-24">
			<div class="max-w-3xl mx-auto w-full">
				<p class="font-mono text-xs uppercase tracking-[0.14em] text-primary" data-animate style="--d: 0">
					04 — {t('nav.faq')}
				</p>
				<h2 class="mt-4 mb-8 font-display text-3xl font-semibold leading-[1.12] tracking-tight md:mb-10 md:text-4xl" data-animate style="--d: 0">
					{t('faq.title')}
				</h2>
				<div class="flex flex-col gap-px border-y border-base-content/10 bg-base-content/10">
					{items.map((item, i) => (
						<details class="group bg-base-200 px-1" data-animate style={`--d: ${i + 1}`}>
							<summary class="flex cursor-pointer items-start justify-between gap-4 py-5 font-medium text-[16.5px] list-none hover:text-primary">
								{item.q}
								<span class="shrink-0 font-mono text-lg leading-none text-primary transition-transform group-open:rotate-45">+</span>
							</summary>
							<p class="pb-6 pr-11 text-[15.5px] leading-relaxed text-base-content/60 text-pretty">{item.a}</p>
						</details>
					))}
				</div>
			</div>
		</section>
	)
}
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
