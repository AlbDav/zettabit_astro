---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
import {
	defaultLang,
	getContent,
	getLocalizedPath,
	getLocalizedServicePath,
	useTranslations,
} from '../i18n/utils';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
const { services } = getContent(lang);
const homePath = getLocalizedPath(lang);
const year = new Date().getFullYear();
const vat = site.vat;
---

<footer class="bg-base-300 text-base-content border-t border-base-content/10">
	<div class="max-w-6xl mx-auto px-4 md:px-8 py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
		<div class="flex flex-col gap-3">
			<a href={`${homePath}#home`} class="flex items-center gap-2 text-xl font-bold">
				<img src="/favicon.svg" alt="" width="28" height="28" class="h-7 w-7 rounded-md" />
				{site.siteName}
			</a>
			<p class="text-sm text-base-content/70 max-w-xs">{t('footer.tagline')}</p>
			<p class="text-sm text-base-content/70">{t('footer.location')}</p>
		</div>

		<nav class="flex flex-col gap-2" aria-label={t('nav.services')}>
			<h3 class="footer-title opacity-100 text-base-content/70">{t('nav.services')}</h3>
			{services.map((service) => (
				<a
					href={getLocalizedServicePath(lang, service.slug)}
					class="link link-hover text-sm text-base-content/70"
				>
					{service.title}
				</a>
			))}
		</nav>

		<div class="flex flex-col gap-3">
			<h3 class="footer-title opacity-100 text-base-content/70">{t('footer.connect')}</h3>
			<a href={`mailto:${site.email}`} class="link link-hover text-sm text-base-content/70">{site.email}</a>
			<SocialLinks class="-ml-2" />
		</div>
	</div>

	<div class="border-t border-base-content/10">
		<div class="max-w-6xl mx-auto px-4 md:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-center">
			<p class="text-xs text-base-content/70">© {year} {site.siteName} · P.IVA {vat}</p>
			<nav class="flex items-center gap-4" aria-label={t('footer.privacy')}>
				<a href={`${homePath}privacy/`} class="link link-hover text-xs text-base-content/70">{t('footer.privacy')}</a>
				<a href={`${homePath}cookie-policy/`} class="link link-hover text-xs text-base-content/70">{t('footer.cookie')}</a>
			</nav>
		</div>
	</div>
</footer>
