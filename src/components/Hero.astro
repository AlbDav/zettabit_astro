---
import { site } from '../data/site';
---

<section id="home" class="hero min-h-[85vh] bg-base-200 relative overflow-hidden">
	<div class="absolute inset-0 pointer-events-none">
		<div
			class="absolute inset-0 opacity-40"
			style="background-image: linear-gradient(to right, rgba(255,255,255,0.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 44px 44px;"
		>
		</div>
		<div class="absolute top-0 -left-32 h-96 w-96 rounded-full bg-primary/25 blur-[100px]"></div>
		<div class="absolute bottom-0 -right-24 h-80 w-80 rounded-full bg-secondary/25 blur-[100px]"></div>
	</div>
	<div class="hero-content text-center relative z-10">
		<div class="max-w-2xl flex flex-col items-center gap-6">
			<div class="badge badge-primary badge-outline">Disponibile per nuovi progetti</div>
			<h1 class="text-4xl md:text-6xl font-bold leading-tight">{site.headline}</h1>
			<p class="text-lg text-base-content/70">{site.subheadline}</p>
			<div class="flex flex-wrap justify-center gap-3">
				<a href="#come-lavoro" class="btn btn-primary">Come lavoro</a>
				<a href="#contatti" class="btn btn-outline">Contattami</a>
			</div>
		</div>
	</div>
</section>
