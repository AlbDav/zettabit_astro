---
import { defaultLang, getContent, useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
const content = getContent(lang);
---

<section id="home" class="hero min-h-screen bg-base-200 relative overflow-hidden">
	<div class="absolute inset-0 pointer-events-none">
		<div
			class="absolute inset-0 opacity-40"
			style="background-image: linear-gradient(to right, rgba(255,255,255,0.06) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 44px 44px;"
		>
		</div>
		<div class="absolute top-0 -left-32 h-96 w-96 rounded-full bg-primary/25 blur-[100px]"></div>
		<div class="absolute bottom-0 -right-24 h-80 w-80 rounded-full bg-secondary/25 blur-[100px]"></div>
	</div>
	<div class="hero-content text-center relative z-10">
		<div class="max-w-2xl flex flex-col items-center gap-6">
			<h1 class="text-4xl md:text-6xl font-bold leading-tight" data-animate style="--d: 1">{content.headline}</h1>
			<p class="text-lg text-base-content/70" data-animate style="--d: 2">{content.subheadline}</p>
			<div class="flex flex-wrap justify-center gap-3" data-animate style="--d: 3">
				<a href="#contact" class="btn btn-primary">{t('hero.cta.contact')}</a>
				<a href="#process" class="btn btn-outline btn-accent">{t('hero.cta.process')}</a>
			</div>
		</div>
	</div>
</section>
