---
import { defaultLang, getContent, useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
const { projects } = getContent(lang);
---

<section id="portfolio" class="py-20 px-4 md:px-8 bg-base-200">
	<div class="max-w-6xl mx-auto">
		<div class="text-center mb-12">
			<h2 class="text-3xl md:text-4xl font-bold">{t('portfolio.title')}</h2>
			<p class="text-base-content/70 mt-2">{t('portfolio.subtitle')}</p>
		</div>
		<div class="grid md:grid-cols-3 gap-6">
			{
				projects.map((project) => (
					<div class="card bg-base-100 shadow-sm">
						<figure class="h-40 bg-gradient-to-br from-primary to-secondary" />
						<div class="card-body">
							<div class="badge badge-ghost">{project.category}</div>
							<h3 class="card-title">{project.title}</h3>
							<p class="text-base-content/70 text-sm">{project.description}</p>
							<div class="card-actions mt-2 flex-wrap gap-1">
								{project.tags.map((tag) => (
									<span class="badge badge-outline badge-sm">{tag}</span>
								))}
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
