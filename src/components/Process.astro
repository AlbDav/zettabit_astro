---
import { defaultLang, getContent, useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
const { process } = getContent(lang);
---

<section id="process" class="py-20 px-4 md:px-8 bg-base-200">
	<div class="max-w-4xl mx-auto">
		<div class="text-center mb-12">
			<h2 class="text-3xl md:text-4xl font-bold">{t('process.title')}</h2>
			<p class="text-base-content/70 mt-2">{t('process.subtitle')}</p>
		</div>
		<ul class="steps steps-vertical lg:steps-horizontal w-full">
			{
				process.map((step) => (
					<li class="step step-primary">
						<div class="text-left lg:text-center pt-2 pb-4">
							<p class="font-semibold">{step.title}</p>
							<p class="text-sm text-base-content/70 mt-1 max-w-xs lg:mx-auto">{step.description}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>
