---
import { defaultLang, getContent, useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
const { process } = getContent(lang);

const CIRCLE_MS = 400;
const LINE_MS = 300;

let cursor = 0;
const timings = process.map((_, i) => {
	let lineDelay = 0;
	if (i > 0) {
		lineDelay = cursor;
		cursor += LINE_MS;
	}
	const circleDelay = cursor;
	cursor += CIRCLE_MS;
	return { circleDelay, lineDelay };
});
---

<section id="process" class="min-h-screen flex flex-col justify-center py-20 px-4 md:px-8 bg-base-200">
	<div class="max-w-4xl mx-auto">
		<div class="text-center mb-12" data-animate style="--d: 0">
			<h2 class="text-3xl md:text-4xl font-bold">{t('process.title')}</h2>
			<p class="text-base-content/70 mt-2">{t('process.subtitle')}</p>
		</div>
		<ul class="steps steps-vertical lg:steps-horizontal w-full">
			{
				process.map((step, i) => (
					<li
						class="step step-primary"
						data-animate="step"
						style={`--circle-delay: ${timings[i].circleDelay}ms; --line-delay: ${timings[i].lineDelay}ms`}
					>
						<div class="text-left lg:text-center pt-2 pb-4" data-animate style={`transition-delay: ${timings[i].circleDelay}ms`}>
							<p class="font-semibold">{step.title}</p>
							<p class="text-xs font-medium uppercase tracking-wide text-primary mt-1">{step.meta}</p>
							<p class="text-sm text-base-content/70 mt-1 max-w-xs lg:mx-auto">{step.description}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>
