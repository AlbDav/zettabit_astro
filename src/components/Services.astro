---
import { defaultLang, getContent, useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
const { services } = getContent(lang);
---

<section id="services" class="min-h-screen flex flex-col justify-center py-20 px-4 md:px-8 max-w-6xl mx-auto">
	<div class="text-center mb-12" data-animate style="--d: 0">
		<h2 class="text-3xl md:text-4xl font-bold">{t('services.title')}</h2>
		<p class="text-base-content/70 mt-2">{t('services.subtitle')}</p>
	</div>
	<div class="grid md:grid-cols-2 gap-6">
		{
			services.map((service, i) => (
				<div class="card bg-base-200 shadow-sm" data-animate style={`--d: ${i + 1}`}>
					<div class="card-body">
						<h3 class="card-title">{service.title}</h3>
						<p class="text-base-content/70">{service.description}</p>
						<ul class="mt-4 flex flex-col gap-2">
							{service.features.map((feature) => (
								<li class="flex items-center gap-2 text-sm">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" viewBox="0 0 20 20" fill="currentColor">
										<path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-3-3a1 1 0 111.4-1.4L9 11.6l6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd" />
									</svg>
									{feature}
								</li>
							))}
						</ul>
					</div>
				</div>
			))
		}
	</div>
</section>
