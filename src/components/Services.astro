---
import { defaultLang, getContent, getLocalizedServicePath, useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
const { services } = getContent(lang);
---

<section id="services" class="min-h-screen flex flex-col justify-center py-12 px-4 md:px-8 max-w-6xl mx-auto">
	<div class="text-center mb-8" data-animate style="--d: 0">
		<h2 class="text-3xl md:text-4xl font-bold">{t('services.title')}</h2>
		<p class="text-base-content/70 mt-2">{t('services.subtitle')}</p>
	</div>

	<div class="grid md:grid-cols-2 gap-6">
		{
			services.map((service, i) => (
				<a
					href={getLocalizedServicePath(lang, service.slug)}
					class="card bg-base-200 border border-base-content/10 shadow-sm hover:border-accent transition-colors"
					data-animate
					style={`--d: ${i + 1}`}
				>
					<div class="card-body">
						<h3 class="card-title">{service.title}</h3>
						<p class="text-base-content/70">{service.description}</p>
						<ul class="mt-4 flex flex-col gap-2">
							{service.features.map((feature) => (
								<li class="flex items-center gap-2 text-sm">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" viewBox="0 0 20 20" fill="currentColor">
										<path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7 7a1 1 0 01-1.4 0l-3-3a1 1 0 111.4-1.4L9 11.6l6.3-6.3a1 1 0 011.4 0z" clip-rule="evenodd" />
									</svg>
									{feature}
								</li>
							))}
						</ul>
						<div class="card-actions mt-4">
							<span class="btn btn-outline btn-accent btn-sm">{t('portfolio.cta')}</span>
						</div>
					</div>
				</a>
			))
		}
	</div>

	{/* Connector: two lines drop from the cards and converge into the block below (desktop only). */}
	<svg
		class="hidden md:block w-full h-12 text-base"
		viewBox="0 0 100 100"
		preserveAspectRatio="none"
		aria-hidden="true"
		focusable="false"
	>
		<path d="M25 0 C25 65 50 45 50 100" fill="none" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" />
		<path d="M75 0 C75 65 50 45 50 100" fill="none" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" />
	</svg>

	<div
		class="max-w-2xl mx-auto rounded-box border border-base-content/10 bg-base-200 px-6 py-7 md:px-10 md:py-8 flex flex-col gap-3 text-center"
		data-animate
		style="--d: 3"
	>
		<h3 class="text-2xl md:text-3xl font-bold">{t('why.title')}</h3>
		<p class="text-base-content/70 leading-relaxed">{t('why.p1')}</p>
		<p class="text-base-content/90 font-medium leading-relaxed">{t('why.p2')}</p>
	</div>
</section>
