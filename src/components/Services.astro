---
import { pricing } from '../data/site';
import { defaultLang, getContent, useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
const { services, combo } = getContent(lang);
const [web, video] = services;

const cards = [
	{ ...web, label: web.title, price: pricing.web, highlighted: false },
	{ ...video, label: video.title, price: pricing.video, highlighted: false },
	{ ...combo, price: pricing.combo, highlighted: true },
];
---

<section id="services" class="min-h-screen flex flex-col justify-center bg-base-200 py-16 px-4 md:px-8 md:py-24">
	<div class="mx-auto w-full max-w-6xl">
		<p class="font-mono text-xs uppercase tracking-[0.14em] text-primary" data-animate style="--d: 0">01 — {t('services.title')}</p>
		<h2 class="mt-4 max-w-[24ch] font-display text-3xl font-semibold leading-[1.12] tracking-tight md:text-4xl" data-animate style="--d: 0">
			{t('services.subtitle')}
		</h2>

		<div class="mt-10 grid gap-[18px] md:grid-cols-3 md:mt-12">
			{
				cards.map((card, i) => (
					<article
						class={`relative flex flex-col rounded-2xl border p-6 md:p-8 transition-colors ${
							card.highlighted
								? 'border-primary/30 bg-primary/[0.07] hover:border-primary/60'
								: 'border-base-content/10 bg-[#2a323c] hover:border-primary/45'
						}`}
						data-animate
						style={`--d: ${i + 1}`}
					>
						<p class="font-mono text-[11.5px] uppercase tracking-[0.12em] text-primary">{card.label}</p>
						<h3 class="mt-3.5 font-display text-[1.35rem] font-semibold leading-tight tracking-tight md:text-[1.55rem]">
							{card.headline}
						</h3>
						<p class="mt-4 font-display text-[1.75rem] font-semibold tracking-tight">
							<span class="mr-2 font-mono text-xs font-normal uppercase tracking-[0.1em] text-base-content/70">{t('price.from')}</span>
							{card.price} €
						</p>
						<p class="mt-3.5 text-[15.5px] leading-relaxed text-base-content/70 text-pretty">{card.description}</p>
						<ul class="mt-5 flex flex-col gap-2.5">
							{card.features.map((feature) => (
								<li class="flex gap-2.5 text-[15px] text-base-content/70">
									<span class="text-primary">→</span>
									{feature}
								</li>
							))}
						</ul>
						<a
							href="#contact"
							data-preselect-need={card.needValue}
							class="relative mt-auto self-start pt-7 text-[15px] font-semibold text-primary hover:text-primary/80"
						>
							<span class="border-b border-primary/45 pb-0.5">{card.ctaLabel}</span>
							<span aria-hidden="true" class="absolute inset-0 rounded-2xl"></span>
						</a>
					</article>
				))
			}
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLAnchorElement>('[data-preselect-need]').forEach((link) => {
		link.addEventListener('click', () => {
			const value = link.dataset.preselectNeed;
			const radio = document.querySelector<HTMLInputElement>(`input[name="need"][value="${value}"]`);
			if (!radio) return;
			radio.checked = true;
			radio.dispatchEvent(new Event('change', { bubbles: true }));
		});
	});
</script>
