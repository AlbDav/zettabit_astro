---
// Sezione prezzi della home (handoff "prezzi su zettabit.it", punto 4).
// Il dettaglio dei pacchetti sta solo in /prezzi: qui restano i "da X €" e un
// link, così un cambio di listino si fa in un punto solo.
import { pricing } from '../data/site';
import { defaultLang, formatPrice, getContent, getPricingPath, useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
const { services, combo, pricing: copy } = getContent(lang);
const [web, video] = services;
const pricesHref = getPricingPath(lang);

const cards = [
	{ ...web, label: web.title, price: pricing.web },
	{ ...video, label: video.title, price: pricing.video },
];
const amount = (value: number) => `${formatPrice(lang, value)} €`;
---

<section id="services" class="min-h-screen flex flex-col justify-center bg-base-200 py-16 px-4 md:px-8 md:py-24">
	<div class="mx-auto w-full max-w-6xl">
		<p class="font-mono text-xs uppercase tracking-[0.14em] text-primary" data-animate style="--d: 0">01 — {t('services.title')}</p>
		<h2 class="mt-4 max-w-[24ch] font-display text-3xl font-semibold leading-[1.12] tracking-tight md:text-4xl" data-animate style="--d: 0">
			{t('services.subtitle')}
		</h2>

		{/* Web e video affiancati, Web + video sotto a tutta larghezza: è il
		    pacchetto in evidenza, come nella pagina prezzi. */}
		<div class="mt-10 grid gap-[18px] md:grid-cols-2 md:mt-12">
			{
				cards.map((card, i) => (
					<article
						class="relative flex flex-col rounded-2xl border border-base-content/10 bg-[#2a323c] p-6 transition-colors hover:border-primary/45 md:p-8"
						data-animate
						style={`--d: ${i + 1}`}
					>
						<p class="font-mono text-[11.5px] uppercase tracking-[0.12em] text-primary">{card.label}</p>
						<h3 class="mt-3.5 font-display text-[1.35rem] font-semibold leading-tight tracking-tight md:text-[1.55rem]">
							{card.headline}
						</h3>
						<div class="mt-4 flex flex-wrap items-baseline gap-x-4 gap-y-1.5">
							<p class="font-display text-[1.75rem] font-semibold tracking-tight">
								<span class="mr-2 font-mono text-xs font-normal uppercase tracking-[0.1em] text-base-content/70">{t('price.from')}</span>
								{amount(card.price)}
							</p>
							<a href={pricesHref} class="relative z-10 text-[15px] font-bold text-primary hover:text-primary/80">
								<span class="border-b border-primary/45 pb-0.5">{copy.seeAll}</span>
							</a>
						</div>
						<p class="mt-3.5 text-[15.5px] leading-relaxed text-base-content/70 text-pretty">{card.tagline}</p>
						<a
							href="#contact"
							data-preselect-need={card.needValue}
							class="relative mt-auto self-start pt-7 text-[15px] font-semibold text-primary hover:text-primary/80"
						>
							<span class="border-b border-primary/45 pb-0.5">{card.ctaLabel}</span>
							<span aria-hidden="true" class="absolute inset-0 rounded-2xl"></span>
						</a>
					</article>
				))
			}

			<article
				class="relative flex flex-col rounded-3xl bg-primary p-6 text-primary-content md:col-span-2 md:rounded-[28px] md:p-10"
				data-animate
				style="--d: 3"
			>
				<p class="inline-block self-start rounded-full bg-base-100 px-3 py-1 font-mono text-[13px] font-bold uppercase tracking-[0.1em] text-primary">
					{combo.label}
				</p>
				<h3 class="mt-5 max-w-[20ch] font-display text-[1.75rem] font-bold leading-[1.15] tracking-tight md:text-[2.25rem]">
					{combo.headline}
				</h3>
				<div class="mt-4 flex flex-wrap items-baseline gap-x-4 gap-y-1.5">
					<p class="font-display text-[2.5rem] font-bold tracking-tight md:text-[3.5rem]">
						<span class="mr-2 align-middle font-mono text-sm font-normal uppercase tracking-[0.1em] text-primary-content/80">{t('price.from')}</span>
						{amount(pricing.combo)}
					</p>
					<a href={pricesHref} class="relative z-10 text-[15px] font-bold text-primary-content hover:text-primary-content/80">
						<span class="border-b border-primary-content/45 pb-0.5">{copy.seeAll}</span>
					</a>
				</div>
				<p class="mt-3.5 text-[17px] leading-relaxed text-primary-content/80 text-pretty">{combo.tagline}</p>
				<a
					href="#contact"
					data-preselect-need={combo.needValue}
					class="relative mt-auto self-start pt-7 text-[15px] font-semibold text-primary-content hover:text-primary-content/80"
				>
					<span class="border-b border-primary-content/45 pb-0.5">{combo.ctaLabel}</span>
					<span aria-hidden="true" class="absolute inset-0 rounded-3xl"></span>
				</a>
			</article>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLAnchorElement>('[data-preselect-need]').forEach((link) => {
		link.addEventListener('click', () => {
			const value = link.dataset.preselectNeed;
			const radio = document.querySelector<HTMLInputElement>(`input[name="need"][value="${value}"]`);
			if (!radio) return;
			radio.checked = true;
			radio.dispatchEvent(new Event('change', { bubbles: true }));
		});
	});
</script>
