---
import { pricing } from '../data/site';
import { defaultLang, useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
const subtitle = t('sticky.subtitle').replace('{price}', String(pricing.web));
---

<div
	id="sticky-cta"
	data-sticky-cta
	hidden
	class="lg:hidden fixed inset-x-0 bottom-0 z-[60] flex items-center gap-3 border-t border-base-content/10 bg-base-300/95 backdrop-blur-md px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))]"
>
	<div class="flex-1 min-w-0">
		<p class="text-sm font-semibold">{t('sticky.title')}</p>
		<p class="text-[12.5px] text-base-content/70 mt-0.5">{subtitle}</p>
	</div>
	<a href="#contact" class="btn btn-primary btn-sm rounded-lg shrink-0">{t('nav.cta')}</a>
</div>

<script>
	(function () {
		const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
		const hero = document.getElementById('home');
		const contact = document.getElementById('contact');
		if (!bar || !hero || !contact || !('IntersectionObserver' in window)) return;

		let heroVisible = true;
		let contactVisible = false;

		function sync() {
			bar!.hidden = heroVisible || contactVisible;
		}

		new IntersectionObserver(
			(entries) => {
				heroVisible = entries[0].isIntersecting;
				sync();
			},
			{ rootMargin: '-66px 0px 0px 0px', threshold: 0 }
		).observe(hero);

		new IntersectionObserver(
			(entries) => {
				contactVisible = entries[0].isIntersecting;
				sync();
			},
			{ threshold: 0 }
		).observe(contact);
	})();
</script>
