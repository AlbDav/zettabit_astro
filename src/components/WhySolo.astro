---
import { defaultLang, useTranslations } from '../i18n/utils';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
---

<section class="px-4 md:px-8 pb-20 max-w-6xl mx-auto">
	<div
		class="max-w-3xl mx-auto rounded-box border border-base-content/10 bg-base-200 px-6 py-8 md:px-10 md:py-10 flex flex-col gap-4"
		data-animate
		style="--d: 0"
	>
		<h3 class="text-2xl md:text-3xl font-bold">{t('why.title')}</h3>
		<p class="text-base-content/70 leading-relaxed">{t('why.p1')}</p>
		<p class="text-base-content/90 font-medium leading-relaxed">{t('why.p2')}</p>
	</div>
</section>
