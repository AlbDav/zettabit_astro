---
// Latin-only subsets: the site ships Italian and English, and the full-family
// imports were emitting @font-face blocks for cyrillic / vietnamese / latin-ext
// into the single render-blocking stylesheet for glyphs no page ever uses.
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/space-grotesk/latin-700.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
// The two faces that paint the LCP element (the h1 in Space Grotesk 600) and the
// body copy right under it. Preloaded so they are requested with the stylesheet
// instead of after it, which is what turns `font-display: swap` into a visible
// reflow on a cold load.
import displayFont from '@fontsource/space-grotesk/files/space-grotesk-latin-600-normal.woff2?url';
import bodyFont from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import CookieConsent from '../components/CookieConsent.astro';
import { analyticsEnabled } from '../data/analytics';
import { pricing, site, skills } from '../data/site';
import { defaultLang, getContent, languages, useTranslations } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
	breadcrumbs?: { name: string; url: string }[];
	/** Keeps a page out of the index while leaving its links crawlable. */
	noindex?: boolean;
}

const lang = Astro.currentLocale ?? defaultLang;
const content = getContent(lang);
const t = useTranslations(lang);
const {
	title = content.seo.title,
	description = content.seo.description,
	breadcrumbs,
	noindex = false,
} = Astro.props;

// Same page in the other language (P5.1): strip/add the /en prefix off the current path.
const path = Astro.url.pathname;
const basePath = lang === 'en' ? path.replace(/^\/en(?=\/|$)/, '') || '/' : path;
const itHref = basePath;
const enHref = basePath === '/' ? '/en/' : `/en${basePath}`;
const selfHref = lang === 'en' ? enHref : itHref;

const abs = (href: string) => new URL(href, Astro.site).href;
const canonical = abs(selfHref);
const origin = new URL(Astro.site ?? 'https://zettabit.it').origin;
const isHome = basePath === '/';

const ogLocale = lang === 'it' ? 'it_IT' : 'en_US';
const ogLocaleAlt = lang === 'it' ? 'en_US' : 'it_IT';

// One 1200×630 card per language, regenerated by `npm run og`.
const ogImage = abs(lang === 'en' ? '/og/og-en.png' : '/og/og-it.png');
const ogImageAlt = `${site.siteName} — ${content.role}`;

// Crawler directives. Without max-image-preview:large Google caps the thumbnail
// it may show next to the result at a small square, and max-snippet:-1 lifts the
// default snippet length limit — both are pure SERP presentation wins.
const robots = noindex
	? 'noindex, follow'
	: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// ── Structured data (P5.5) ───────────────────────────────────────────────────
// One @graph rather than a pile of disconnected scripts: the @id references are
// what let Google resolve "the Person who founded the business that publishes
// this page" into a single entity instead of three unrelated ones.
const businessId = `${origin}/#business`;
const personId = `${origin}/#davide-albano`;
const websiteId = `${origin}/#website`;
const pageId = `${canonical}#webpage`;

const offerFor = (service: (typeof content.services)[number], minPrice: number) => ({
	'@type': 'Offer',
	itemOffered: {
		'@type': 'Service',
		name: service.title,
		description: service.description,
		serviceType: service.title,
		provider: { '@id': businessId },
		areaServed: { '@type': 'Country', name: 'Italia' },
	},
	priceSpecification: {
		'@type': 'PriceSpecification',
		minPrice,
		priceCurrency: 'EUR',
		valueAddedTaxIncluded: false,
	},
});

const graph: object[] = [
	{
		'@type': 'WebSite',
		'@id': websiteId,
		url: `${origin}/`,
		name: site.siteName,
		inLanguage: ['it-IT', 'en'],
		publisher: { '@id': businessId },
	},
	{
		'@type': 'ProfessionalService',
		'@id': businessId,
		name: site.siteName,
		alternateName: site.name,
		url: `${origin}/`,
		image: abs('/og/og-it.png'),
		logo: abs('/favicon.svg'),
		email: site.email,
		// EU VAT numbers carry the country prefix in schema.org; the footer prints the
		// bare number, which is the Italian convention there.
		vatID: `IT${site.vat}`,
		description: content.seo.description,
		priceRange: '€€',
		currenciesAccepted: 'EUR',
		knowsLanguage: ['it', 'en'],
		areaServed: [
			{ '@type': 'City', name: 'Roma' },
			{ '@type': 'Country', name: 'Italia' },
		],
		address: { '@type': 'PostalAddress', addressLocality: 'Roma', addressRegion: 'RM', addressCountry: 'IT' },
		geo: { '@type': 'GeoCoordinates', latitude: 41.9028, longitude: 12.4964 },
		founder: { '@id': personId },
		employee: { '@id': personId },
		sameAs: Object.values(site.social),
		hasOfferCatalog: {
			'@type': 'OfferCatalog',
			name: content.services.map((s) => s.title).join(' · '),
			itemListElement: [
				offerFor(content.services[0], pricing.web),
				offerFor(content.services[1], pricing.video),
			],
		},
	},
	{
		'@type': 'Person',
		'@id': personId,
		name: site.name,
		jobTitle: content.role,
		description: t('about.bio'),
		url: `${origin}/`,
		email: site.email,
		worksFor: { '@id': businessId },
		knowsAbout: skills,
		address: { '@type': 'PostalAddress', addressLocality: 'Roma', addressCountry: 'IT' },
		sameAs: Object.values(site.social),
	},
	{
		'@type': 'WebPage',
		'@id': pageId,
		url: canonical,
		name: title,
		description,
		inLanguage: lang === 'it' ? 'it-IT' : 'en',
		isPartOf: { '@id': websiteId },
		about: { '@id': businessId },
		primaryImageOfPage: ogImage,
		...(isHome ? { mainEntity: { '@id': businessId } } : {}),
		...(breadcrumbs?.length ? { breadcrumb: { '@id': `${canonical}#breadcrumb` } } : {}),
	},
];

if (breadcrumbs?.length) {
	graph.push({
		'@type': 'BreadcrumbList',
		'@id': `${canonical}#breadcrumb`,
		itemListElement: breadcrumbs.map((b, i) => ({
			'@type': 'ListItem',
			position: i + 1,
			name: b.name,
			item: abs(b.url),
		})),
	});
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<html lang={lang === 'it' ? 'it-IT' : 'en'}>
	<head>
		<meta charset="utf-8" />
		<script is:inline define:vars={{ currentLocale: lang, supported: Object.keys(languages), alt: { it: itHref, en: enHref } }}>
			// Render-blocking in <head>, before first paint: send visitors to this same
			// page in their preferred language rather than painting the wrong one first.
			(function () {
				try {
					// Crawlers are deliberately exempt. Googlebot renders JS and requests
					// with an en-US locale, so without this guard it would be bounced off
					// every Italian URL — the canonical ones — and onto /en/, which reads
					// as a redirect away from the indexed page. Humans still get the
					// language switch; bots get the URL they asked for.
					var ua = navigator.userAgent || '';
					if (/bot\b|bot\/|crawl|spider|slurp|bingpreview|lighthouse|headless|chrome-lighthouse|google|facebookexternalhit|embedly|quora link preview|whatsapp|telegram|discord|pinterest|applebot|petalbot|yandex|baiduspider|ia_archiver|duckduckbot/i.test(ua) || navigator.webdriver) {
						return;
					}
					var stored = localStorage.getItem('preferredLang');
					if (!stored) {
						var browserLang = ((navigator.language || 'it').split('-')[0] || 'it').toLowerCase();
						var target = supported.indexOf(browserLang) !== -1 ? browserLang : 'it';
						if (target !== currentLocale && alt[target]) {
							window.location.replace(alt[target]);
							return;
						}
					}
					localStorage.setItem('preferredLang', currentLocale);
				} catch (e) {}
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#2a303c" />
		<meta name="generator" content={Astro.generator} />

		<link rel="preload" as="font" type="font/woff2" href={displayFont} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<meta name="author" content={site.name} />
		{/* The 404 page is served at every unmatched URL, so a canonical pointing at
		    /404/ would be a lie and its hreflang cluster would be noise. Skipped
		    along with the rest of the indexing hints on any noindex page. */}
		{!noindex && (
			<>
				<link rel="canonical" href={canonical} />
				<link rel="alternate" hreflang="it" href={abs(itHref)} />
				<link rel="alternate" hreflang="en" href={abs(enHref)} />
				<link rel="alternate" hreflang="x-default" href={abs(itHref)} />
			</>
		)}
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={ogLocaleAlt} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<a href="#main-content" class="skip-link">{t('a11y.skip')}</a>
		<slot />
		<script is:inline>
			(function () {
				var els = document.querySelectorAll('[data-animate]');
				if (!els.length) return;
				var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (prefersReduced || !('IntersectionObserver' in window)) {
					els.forEach(function (el) { el.classList.add('in-view'); });
					return;
				}
				var observer = new IntersectionObserver(
					function (entries) {
						entries.forEach(function (entry) {
							if (entry.isIntersecting) {
								entry.target.classList.add('in-view');
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
				);
				els.forEach(function (el) { observer.observe(el); });
			})();
		</script>
		{analyticsEnabled && <CookieConsent />}
	</body>
</html>
